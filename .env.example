# ── LLM Provider ─────────────────────────────────────────────────────────────
# Which provider to use first. Fallback chain: groq → gemini → ollama
# Options: groq | gemini | ollama | none
LLM_PROVIDER=groq

# ── Groq (free tier) ──────────────────────────────────────────────────────────
# Get keys at https://console.groq.com — no credit card required
GROQ_MODEL=openai/gpt-oss-120b
# Single key:
# GROQ_API_KEY=your_groq_api_key_here
# Multiple keys (optional, round-robin — recommended to avoid rate limits):
# GROQ_API_KEY_1=your_first_groq_api_key
# GROQ_API_KEY_2=your_second_groq_api_key
# GROQ_API_KEY_3=your_third_groq_api_key

# ── Gemini (free tier) ────────────────────────────────────────────────────────
# Get keys at https://aistudio.google.com
GEMINI_MODEL=gemini-flash-lite-latest
# Single key:
# GEMINI_API_KEY=your_gemini_api_key_here
# Multiple keys (optional, round-robin — recommended to avoid rate limits):
# GEMINI_API_KEY_1=your_first_gemini_api_key
# GEMINI_API_KEY_2=your_second_gemini_api_key
# GEMINI_API_KEY_3=your_third_gemini_api_key

# ── Ollama (local — no key needed) ───────────────────────────────────────────
# Install from https://ollama.com — run `ollama pull gemma3:4b` first
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_BASE=http://localhost:11434

# ── ZAP ──────────────────────────────────────────────────────────────────────
# Used by WebAgent. Start ZAP in daemon mode on port 8090.
# Docker Compose sets these automatically — only needed for local/manual setup.
ZAP_API_BASE=http://localhost:8090
ZAP_API_KEY=changeme

# ── Database (optional) ───────────────────────────────────────────────────────
# SQLite is used by default (vapt.db auto-created on first run).
# Uncomment to switch to PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/vapt

# ── Per-provider timeouts (optional) ─────────────────────────────────────────
# GROQ_TIMEOUT=30
# GEMINI_TIMEOUT=30
# OLLAMA_TIMEOUT=180

# ── Agent iteration limits (optional) ────────────────────────────────────────
# WEB_MAX_ITERATIONS=30
# NETWORK_MAX_ITERATIONS=20
# CLOUD_MAX_ITERATIONS=20
